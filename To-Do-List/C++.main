#include<iostream>
#include<vector>
#include<string>
using namespace std;

int main(){
    vector<string> tasks;
    int choice,i,num;
    string task;

    do{
        cout<<"\n ---to do list---\n";
        cout<<"1. Add task\n";
        cout<<"2.Views task\n";
        cout<<"3.Delete task\n";
        cout<<"4. Exit\n";
        cout<<"enter your choice:";
        cin>>choice;

        cin.ignore();

        switch(choice){
            case 1:
            cout<<"enter task:";
            getline(cin,task);
            tasks.push_back(task);
            cout<<"task Added Succefully!\n";
            break;
            case 2:
            if(tasks.empty()){
                cout<<"No tasks available.\n";
            }
            else{
                cout<<"\nyour tasks:\n";
                for( i =0;i<tasks.size();i++){
                    cout<<i+1<<" "<<tasks[i]<<endl;
                }
            }
            break;
            case 3:

            if(tasks.empty()){
                cout<<"\n tasks to delete.\n";
            }
            else{
                cout<<"\ntasks:\n";
                for( i=0;i<tasks.size();i++){
                    cout<<i+1<<" "<<tasks[i]<<endl;

                }
                cout<<"enter task number to delete:";
                cin>>num;if(num>0&&num<=tasks.size()){
                    tasks.erase(tasks.begin()+(num-1));
                    cout<<"tasks deleted successfully!\n";
                }
                else{
                    cout<<"invalide task number!\n";
                }
            }
            break;
            case 4:
            cout<<"exiting program..\n";
            break;
            default:
            cout<<"invalide choice!\n";
        }
    }
    while(choice!=4);
    return 0;
    
    
}
