#include<iostream>
#include<cstdlib>
#include<ctime>
using namespace std;

int main()
{
    srand(time(0)); // srand -change the random number every time

    int number= rand() % 100 + 1; // rand - generates a random number
    int user_number;

    cout<<"----Number Guessing Game----"<<endl;
    cout<<"Guess a number between 1 to 100"<<endl;

    do
    { cout<<"enter your number:";
        cin>>user_number;

        if(user_number > number){
            cout<<" Oops..Too High! try a small number."<<endl;
        }
        else if(user_number < number){
            cout<<"Oops..Too Low! try a bigger number."<<endl;
        }
        else{
            cout<<"Yayy! you did it."<<endl;
        }
        
    }
    while(user_number != number);
   
    return 0;
    
 } 
