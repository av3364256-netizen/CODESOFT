#include<iostream>
using namespace std;

int main()
{
    int choice;
    double number1,number2,result;
    
    cout<<"---SIMPLE CALCULATOR---"<<endl;
    cout<<"Enter your first number:";
    cin>>number1;
    cout<<"Enter you second number:";
    cin>>number2;

    cout<<"\n choose operation"<<endl;
    cout<<"1. Addition"<<endl;
    cout<<"2.Subtract"<<endl;
    cout<<"3.division"<<endl;
    cout<<"4.multipication"<<endl;
    cout<<"5.module"<<endl;

    cout<<"enter your choice:";
    cin>>choice;
    switch (choice)
    {
    case 1:
        result= number1+number2;
        cout<<"result="<<result;
        break;
    case 2:
        result= number1-number2;
        cout<<"result="<<result;
        break;
    case 3:
    if(number2 !=0){
        result= number1+number2;
        cout<<"result="<<result;
    }
    else{
        cout<<"can not divide by zero(0)";
    }
        break;
    case 4:
        result= number1*number2;
        cout<<"result="<<result;
        break;
    case 5:
    if(number2!=0){
        result= (int)number1 % (int)number2;
        cout<<"result="<<result;
    }
    else{
        cout<<" enter the number which is greater then zero(0)";
    }
       break;
    
    default:
    cout<<" invalide choice!";
    break;
        
    }
    return 0;
}
